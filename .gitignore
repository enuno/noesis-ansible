# Ansible Vault password files
.vault_pass
*.vault_pass

# Encrypted secrets
secrets.yml
**/secrets.yml
**/group_vars/secrets.yml
**/host_vars/secrets.yml

# Local secrets directory
secrets/
**/secrets/

# Environment files with credentials
.env
**/.env

# macOS metadata
.DS_Store
**/.DS_Store

# Ansible retry files
*.retry

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Local kubectl client cache (discovery + HTTP cache) -- runtime state only
.kube/

# Backup files
*.bak
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.iml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Isolated prodqual offline staging (never a live destination)
inventory/prodqual_loopback_fixture/staging/

# Node modules (if any frontend work)
node_modules/

# OS files
Thumbs.db
desktop.ini

# Local Ansible collections/roles cache populated by requirements.yml.
# Runtime state, not source: 61MB / ~4800 files that `ansible-galaxy install`
# recreates on demand. Same rationale as .kube/ above.
.ansible/

# Test and linter scratch caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Values rendered by the offline suites; the tests remove these on success,
# so one left behind is a crashed run's leftover and never source.
tests/**/.rendered-*.yml
