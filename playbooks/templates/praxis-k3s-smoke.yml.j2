# {{ ansible_managed }}
# Temporary k3s smoke-test resources. Applied and deleted by
# playbooks/k3s-verify.yml within the {{ k3s_smoke_ns }} namespace.
# All images are pinned by tag (never :latest); all Services are ClusterIP.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ k3s_smoke_ns }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: praxis-smoke-web
  namespace: {{ k3s_smoke_ns }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: praxis-smoke-web
  template:
    metadata:
      labels:
        app: praxis-smoke-web
    spec:
      containers:
        - name: web
          image: {{ k3s_smoke_image }}
          ports:
            - containerPort: 80
          readinessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 2
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: praxis-smoke-svc
  namespace: {{ k3s_smoke_ns }}
spec:
  type: ClusterIP
  selector:
    app: praxis-smoke-web
  ports:
    - port: 80
      targetPort: 80
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: praxis-smoke-pvc
  namespace: {{ k3s_smoke_ns }}
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 64Mi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: praxis-smoke-writer
  namespace: {{ k3s_smoke_ns }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: praxis-smoke-writer
  template:
    metadata:
      labels:
        app: praxis-smoke-writer
    spec:
      containers:
        - name: writer
          image: {{ k3s_smoke_util_image }}
          command:
            - sh
            - -c
            - "echo praxis-smoke-ok | tee /data/probe.txt && tail -f /dev/null"
          volumeMounts:
            - name: data
              mountPath: /data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: praxis-smoke-pvc
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: praxis-smoke-reader
  namespace: {{ k3s_smoke_ns }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: praxis-smoke-reader
  template:
    metadata:
      labels:
        app: praxis-smoke-reader
    spec:
      containers:
        - name: reader
          image: {{ k3s_smoke_util_image }}
          command:
            - sh
            - -c
            - "cat /data/probe.txt && tail -f /dev/null"
          volumeMounts:
            - name: data
              mountPath: /data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: praxis-smoke-pvc
