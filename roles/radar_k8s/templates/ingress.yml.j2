# Dedicated operator-managed Tailscale Ingress for Radar.
# The operator (OPERATOR_INGRESS_CLASS_NAME=tailscale) mints a per-service
# tailnet device named after the SHORT host below and publishes
# <host>.<tailnet domain> in status.loadBalancer.ingress[0].hostname.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: "{{ radar_k8s_release_name }}"
  namespace: "{{ radar_k8s_namespace }}"
  labels:
    app.kubernetes.io/name: radar
    app.kubernetes.io/instance: "{{ radar_k8s_release_name }}"
    app.kubernetes.io/managed-by: ansible-radar-k8s
spec:
  ingressClassName: "{{ radar_k8s_tailscale_ingress_class }}"
  rules:
    - host: "{{ radar_k8s_hostname }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "{{ radar_k8s_release_name }}"
                port:
                  number: {{ radar_k8s_service_port | int }}
  tls:
    - hosts:
        - "{{ radar_k8s_hostname }}"
