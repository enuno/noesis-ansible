apiVersion: v1
kind: Service
metadata:
  name: unifi-mcp-postgres
  namespace: {{ unifi_mcp_namespace }}
spec:
  clusterIP: None
  selector: {app: unifi-mcp-postgres}
  ports:
    - {name: postgres, port: 5432, targetPort: 5432}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: unifi-mcp-postgres
  namespace: {{ unifi_mcp_namespace }}
spec:
  serviceName: unifi-mcp-postgres
  replicas: 1
  selector:
    matchLabels: {app: unifi-mcp-postgres}
  template:
    metadata:
      labels: {app: unifi-mcp-postgres}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: postgres
          image: {{ unifi_mcp_postgres_image }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          ports:
            - {containerPort: 5432, name: postgres}
          env:
            - {name: POSTGRES_DB, value: unifi}
            - {name: POSTGRES_USER, value: unifi}
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef: {name: {{ unifi_mcp_database_secret_name }}, key: POSTGRES_PASSWORD}
            - {name: PGDATA, value: /var/lib/postgresql/data/pgdata}
          readinessProbe:
            exec:
              command: [pg_isready, -U, unifi, -d, unifi]
            periodSeconds: 5
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {memory: 1Gi}
          volumeMounts:
            - {name: data, mountPath: /var/lib/postgresql/data}
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: [ReadWriteOnce]
        storageClassName: {{ unifi_mcp_storage_class }}
        resources:
          requests:
            storage: {{ unifi_mcp_postgres_size }}
---
apiVersion: v1
kind: Service
metadata:
  name: unifi-mcp-redis
  namespace: {{ unifi_mcp_namespace }}
spec:
  selector: {app: unifi-mcp-redis}
  ports:
    - {name: redis, port: 6379, targetPort: 6379}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: unifi-mcp-redis-data
  namespace: {{ unifi_mcp_namespace }}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: {{ unifi_mcp_storage_class }}
  resources:
    requests:
      storage: {{ unifi_mcp_redis_size }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: unifi-mcp-redis
  namespace: {{ unifi_mcp_namespace }}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels: {app: unifi-mcp-redis}
  template:
    metadata:
      labels: {app: unifi-mcp-redis}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: redis
          image: {{ unifi_mcp_redis_image }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          command: [/bin/sh, -ec]
          # Keep password out of argv; only the 0600 config file carries it.
          args:
            - 'umask 077; printf "requirepass %s\nappendonly yes\ndir /data\n" "$REDIS_PASSWORD" > /tmp/redis.conf; exec redis-server /tmp/redis.conf'
          env:
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef: {name: {{ unifi_mcp_redis_secret_name }}, key: REDIS_PASSWORD}
          ports:
            - {containerPort: 6379, name: redis}
          readinessProbe:
            exec:
              command: [/bin/sh, -ec, 'REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli ping | grep -q PONG']
            periodSeconds: 5
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits: {memory: 512Mi}
          volumeMounts:
            - {name: data, mountPath: /data}
            - {name: config, mountPath: /tmp}
      volumes:
        - name: data
          persistentVolumeClaim: {claimName: unifi-mcp-redis-data}
        - name: config
          emptyDir: {medium: Memory}
