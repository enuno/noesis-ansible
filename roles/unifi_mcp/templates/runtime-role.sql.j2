\set ON_ERROR_STOP on
\getenv runtime_password RUNTIME_PASSWORD
DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'unifi_mcp_runtime') THEN
    CREATE ROLE unifi_mcp_runtime LOGIN;
  END IF;
END
$$;
ALTER ROLE unifi_mcp_runtime PASSWORD :'runtime_password';
GRANT CONNECT ON DATABASE {{ unifi_mcp_database_name }} TO unifi_mcp_runtime;
GRANT USAGE ON SCHEMA public TO unifi_mcp_runtime;
GRANT SELECT, INSERT, UPDATE ON credentials, cloud_accounts, controllers, api_tokens TO unifi_mcp_runtime;
GRANT SELECT, INSERT ON audit_log TO unifi_mcp_runtime;
GRANT SELECT, INSERT, UPDATE ON audit_chain_heads TO unifi_mcp_runtime;
GRANT SELECT ON audit_archives TO unifi_mcp_runtime;
GRANT USAGE ON SEQUENCE audit_log_id_seq TO unifi_mcp_runtime;
GRANT SELECT ON unifi_mcp_alembic_version TO unifi_mcp_runtime;
GRANT SELECT, INSERT, UPDATE, DELETE ON sites, device_inventory TO unifi_mcp_runtime;
