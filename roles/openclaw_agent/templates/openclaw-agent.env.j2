# OpenClaw Agent environment — sourced by the Docker container
# Generated by Ansible. Override secrets in host_vars/ or a vault, not here.

HOME={{ openclaw_agent_home }}
OPENCLAW_STATE_DIR={{ openclaw_agent_state_dir }}

# Local model provider (Ollama by default)
{% if openclaw_agent_model_provider == 'ollama' %}
OLLAMA_HOST={{ openclaw_agent_model_base_url | regex_replace('^http://', '') }}
{% endif %}

# Honcho self-hosted credentials
HONCHO_BASE_URL={{ openclaw_agent_honcho_base_url }}
HONCHO_WORKSPACE_ID={{ openclaw_agent_honcho_workspace_id }}
HONCHO_API_KEY={{ openclaw_agent_honcho_api_key }}
