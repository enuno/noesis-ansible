---
# Namespace-scoped Secret holding provider credentials + dashboard basic-auth
# credentials. The chart has no existingSecret support: this Secret is the
# externally managed source referenced through the chart's extraEnvFrom
# mechanism. Values come exclusively from vault-injected role variables.
apiVersion: v1
kind: Secret
metadata:
  name: "{{ hermes_agent_release_name }}-provider"
  namespace: "{{ hermes_agent_namespace }}"
  labels:
    app.kubernetes.io/name: hermes-agent
    app.kubernetes.io/instance: "{{ hermes_agent_release_name }}"
    app.kubernetes.io/managed-by: ansible
type: Opaque
stringData:
  HERMES_DASHBOARD_BASIC_AUTH_USERNAME: {{ hermes_agent_dashboard_username | string | to_json }}
  HERMES_DASHBOARD_BASIC_AUTH_PASSWORD: {{ hermes_agent_dashboard_password | string | to_json }}
{% if hermes_agent_dashboard_session_secret | length > 0 %}
  # Signs the basic provider's stateless session tokens. Without it the pod
  # mints a fresh key per start, so every pod restart logs all operators out.
  HERMES_DASHBOARD_BASIC_AUTH_SECRET: {{ hermes_agent_dashboard_session_secret | string | to_json }}
{% endif %}
{% for key, value in hermes_agent_provider_env.items() %}
  {{ key }}: {{ value | string | to_json }}
{% endfor %}
