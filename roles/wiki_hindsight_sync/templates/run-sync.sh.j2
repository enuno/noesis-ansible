#!/bin/bash
# One-way sync from the llm-wiki into a Hindsight memory bank.
#
# Dry-run by default. This wrapper always passes --apply, so it is only
# ever installed together with an operator approval for scheduled runs.
#
# The API key is read from HINDSIGHT_API_KEY in the environment. It is
# never written to the log, the manifest, or any file this wrapper creates.
#
# Log rotation: 1 MiB with 5 rotations, matching the codebase-state
# collector's convention.
set -euo pipefail

INSTALL_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG="${NOESIS_WIKI_HINDSIGHT_LOG:-{{ wiki_hindsight_sync_log }}}"
STATE_DIR="${NOESIS_WIKI_HINDSIGHT_STATE:-{{ wiki_hindsight_sync_state_dir }}}"

if [[ -z "${HINDSIGHT_API_KEY:-}" ]]; then
  echo "HINDSIGHT_API_KEY is not set; refusing to run." >&2
  exit 2
fi

mkdir -p "$(dirname "$LOG")"
chmod 700 "$(dirname "$LOG")" || true
if [[ -f "$LOG" ]]; then
  size=$(wc -c < "$LOG" | tr -d ' ')
  if [[ "$size" -gt 1048576 ]]; then
    i=5
    while [[ "$i" -ge 1 ]]; do
      if [[ -f "$LOG.$i" ]]; then
        mv "$LOG.$i" "$LOG.$((i + 1))"
      fi
      i=$((i - 1))
    done
    mv "$LOG" "$LOG.1"
    rm -f "$LOG.6"
  fi
fi
touch "$LOG"
chmod 600 "$LOG" || true
exec >>"$LOG" 2>&1

exec {{ wiki_hindsight_sync_python }} -m wiki_hindsight_sync \
  --apply \
  --state-dir "$STATE_DIR" \
  --scope-file "$INSTALL_DIR/scope.json" \
  --wiki-root {{ wiki_hindsight_sync_wiki_root }} \
  --bank {{ wiki_hindsight_sync_bank }} \
  --endpoint {{ wiki_hindsight_sync_endpoint }} \
  --namespace {{ wiki_hindsight_sync_namespace }} \
  --max-documents {{ wiki_hindsight_sync_max_documents }} \
  --max-runtime-s {{ wiki_hindsight_sync_max_runtime_s }} \
  "$@"
