[Unit]
Description=Moshi hook daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ moshi_herdr_service_user }}
WorkingDirectory={{ moshi_herdr_service_home }}
ExecStart={{ moshi_hook_binary_lookup.stdout }} serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
